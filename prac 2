print("SHORTEST SEQUENCE OF MOVES")
for step, (move, state) in enumerate(solution, start=1):
print(f"Step {step}: {move}")
print_state(state)
print("Goal reached successfully!")
print("Total number of moves:", len(solution))
else:
print("No solution found.")
